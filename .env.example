# ---------------------------------------------------------------------------
# Local development defaults. In production these live in Wrangler secrets.
# ---------------------------------------------------------------------------
APP_ENV=development
APP_URL=http://localhost:3000

# Session signing. `openssl rand -base64 32`
SESSION_SECRET=dev-only-session-secret-change-me-please

# Razorpay (leave blank to use the built-in demo payment provider)
# Fill these in to create real orders; webhooks must then be signed.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Supabase Storage (private bucket; configure the service-role key as a Wrangler secret in production)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=nivas-property-media

# Maps (optional – the app falls back to stored coordinates)
MAPS_API_KEY=

# Notifications
EMAIL_FROM=stays@nivas.example
RESEND_API_KEY=
SMS_API_KEY=

# Cron / queue tick protection
CRON_SECRET=dev-cron-secret

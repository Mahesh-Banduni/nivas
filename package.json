{
  "name": "nivas-property-marketplace",
  "version": "1.0.0",
  "private": true,
  "description": "Nivas — a multi-vendor property booking marketplace built with Next.js, D1-style SQLite, Supabase Storage and queue-backed jobs.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "db:reset": "node scripts/reset-db.mjs",
    "db:seed-admin": "node scripts/seed-admin.mjs",
    "test:booking": "node scripts/booking-concurrency-test.mjs",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.17",
    "drizzle-orm": "^0.44.5",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "drizzle-kit": "^0.31.4",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.7.3",
    "wrangler": "^4.161.0"
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nivas",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "APP_ENV": "production"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "nivas"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nivas-prod-db",
      "database_id": "648547b6-b20a-4ab6-b351-657f71f2935f",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "23cf04008ef946efba26b6c05e5994c1"
    }
  ],
  "observability": {
    "enabled": true
  }
}

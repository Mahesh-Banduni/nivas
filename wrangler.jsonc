{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nivas-marketplace",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "APP_ENV": "production",
    "APP_URL": "https://nivas.example"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "nivas-marketplace"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nivas-prod-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PROPERTY_MEDIA",
      "bucket_name": "nivas-property-media",
      "preview_bucket_name": "nivas-property-media-preview"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID",
      "preview_id": "REPLACE_WITH_PREVIEW_KV_ID"
    }
  ],
  "observability": {
    "enabled": true
  }
}
